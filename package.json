{
  "name": "branch-agent",
  "version": "0.19.4",
  "private": true,
  "description": "A local, inspectable personal assistant runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25 || >=25.4.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "branch": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "data/holidays.json",
    "data/providers.json",
    "data/memory-retrieval.json",
    "data/channels.json",
    "data/local-models.json",
    "data/channel-setup.json",
    "data/release-notes.json",
    "data/mcp-catalogue.json",
    "data/add-ons",
    "data/evaluation",
    "data/tool-evaluations",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-ts.mjs && node scripts/ascii-dist.mjs && node scripts/copy-fonts.mjs && node scripts/copy-suites.mjs && node scripts/copy-data.mjs && node scripts/tool-cards.mjs",
    "pretest": "node -e \"require('electron')\"",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "npm run build && node dist/cli.js start",
    "chat": "npm run build && node dist/cli.js chat",
    "doctor": "npm run build && node dist/cli.js doctor",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && node scripts/dependency-notices.mjs && node scripts/package-desktop.mjs",
    "evals": "node evals/run.mjs",
    "evals:smoke": "node evals/run.mjs --model standin --smoke",
    "docs:providers": "node scripts/docs-providers.mjs",
    "pack:cli": "npm run build && node scripts/pack-cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.2.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@types/node": "^24.10.0",
    "axe-core": "4.13.0",
    "electron": "44.3.0",
    "typescript": "^5.9.3"
  },
  "main": "dist/desktop/main.js",
  "productName": "Branch Agent"
}
